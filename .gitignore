Release

# Build artifacts
*.elf
*.uf2
*.map
*.o
*.d
build_make/tools/elf2uf2
tools/elf2uf2/elf2uf2
build_make/.build_profile

# Real WiFi credentials -- never commit these. Copy config/wifi_secrets.example.h
# to config/wifi_secrets.h and fill in your own network's SSID/password.
config/wifi_secrets.h

# Workspace-local broker binaries, installer, machine settings and runtime logs.
tools/mqtt/.runtime/
__pycache__/

# The original Debug build-directory rule also matches this source folder
# on Windows. Track only the debugger scripts; keep all raw target data local.
!tools/debug/
tools/debug/*
!tools/debug/*.cfg
!tools/debug/*.tcl
tools/debug/.runtime/

# Videos are shared as unlisted YouTube links (videos/README.md), never committed
*.mp4
*.mov
*.webm
*.avi
*.mkv

